generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ApiEnvironment {
  TEST
  LIVE
}

enum Network {
  MONCASH
  NATCASH
}

enum Currency {
  HTG
  USD
}

enum TransactionType {
  PAYMENT
  TRANSFER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  EXHAUSTED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum ProviderState {
  OPERATIONAL
  DEGRADED
  DOWN
  UNKNOWN
}

model Plan {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  priceCents          Int?     @map("price_cents")
  currency            String   @default("USD")
  monthlyRequestLimit Int?     @map("monthly_request_limit")
  maxApiKeys          Int?     @map("max_api_keys")
  rateLimitPerMinute  Int?     @map("rate_limit_per_minute")
  transactionFeeBps   Int?     @map("transaction_fee_bps")
  features            Json     @default("[]")
  active              Boolean  @default(true)
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Client {
  id        String       @id @default(uuid())
  name      String
  status    ClientStatus @default(ACTIVE)
  // LIVE keys work only when an administrator has enabled LIVE access (see limits).
  liveEnabled Boolean    @default(false) @map("live_enabled")
  // What the account was set up for: receiving payments and/or sending money.
  canReceive  Boolean    @default(true) @map("can_receive")
  canSend     Boolean    @default(true) @map("can_send")
  // Identity verification (KYC). Required before anything touches real money (LIVE).
  kycStatus      KycStatus @default(NOT_STARTED) @map("kyc_status")
  kycSubmittedAt DateTime? @map("kyc_submitted_at")
  kycReviewedAt  DateTime? @map("kyc_reviewed_at")
  kycReviewedBy  String?   @map("kyc_reviewed_by")
  kycReviewNote  String?   @map("kyc_review_note")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users        User[]
  subscription Subscription?
  apiKeys      ApiKey[]
  transactions Transaction[]
  webhooks     Webhook[]
  usageRecords UsageRecord[]
  invoices     Invoice[]
  apiLogs      ApiLog[]
  fundings     Funding[]
  kycProfile   KycProfile?
  kycDocuments KycDocument[]

  @@map("clients")
}

model User {
  id              String    @id @default(uuid())
  clientId        String    @map("client_id")
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  role            Role      @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([clientId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Subscription {
  id                  String             @id @default(uuid())
  clientId            String             @unique @map("client_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIAL)
  startedAt           DateTime           @default(now()) @map("started_at")
  currentPeriodEnd    DateTime           @map("current_period_end")
  cancelledAt         DateTime?          @map("cancelled_at")
  customRequestLimit  Int?               @map("custom_request_limit")
  customRateLimit     Int?               @map("custom_rate_limit")
  externalCustomerId  String?            @map("external_customer_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

model UsageRecord {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  period       String
  requests     Int      @default(0)
  transactions Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@map("usage_records")
}

enum ApiKeyCategory {
  RECEIVE
  SEND
  BOTH
}

model ApiKey {
  id              String         @id @default(uuid())
  clientId        String         @map("client_id")
  name            String
  environment     ApiEnvironment
  keyPrefix       String         @unique @map("key_prefix")
  last4           String
  hashedSecret    String         @map("hashed_secret")
  permissions     String[]
  // Which API the key is for. BOTH exists only for keys created before the split.
  category        ApiKeyCategory @default(RECEIVE)
  createdByUserId String?        @map("created_by_user_id")
  lastUsedAt      DateTime?      @map("last_used_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([clientId])
  @@map("api_keys")
}

model Transaction {
  id                    String            @id
  clientId              String            @map("client_id")
  apiKeyId              String            @map("api_key_id")
  environment           ApiEnvironment
  provider              Network
  type                  TransactionType   @default(PAYMENT)
  amount                Decimal           @db.Decimal(14, 2)
  currency              Currency
  feeAmount             Decimal           @default(0) @db.Decimal(14, 2) @map("fee_amount")
  totalAmount           Decimal           @db.Decimal(14, 2) @map("total_amount")
  phone                 String
  externalReference     String?           @map("external_reference")
  description           String?
  providerTransactionId String?           @map("provider_transaction_id")
  paymentUrl            String?           @map("payment_url")
  status                TransactionStatus @default(PENDING)
  requestId             String            @map("request_id")
  errorCode             String?           @map("error_code")
  errorMessage          String?           @map("error_message")
  idempotencyKey        String?           @map("idempotency_key")
  requestFingerprint    String?           @map("request_fingerprint")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  client     Client              @relation(fields: [clientId], references: [id])
  apiKey     ApiKey              @relation(fields: [apiKeyId], references: [id])
  events     TransactionEvent[]
  deliveries WebhookDelivery[]

  @@unique([clientId, environment, idempotencyKey])
  @@index([clientId, createdAt])
  @@index([providerTransactionId])
  @@map("transactions")
}

model TransactionEvent {
  id            String            @id @default(uuid())
  transactionId String            @map("transaction_id")
  status        TransactionStatus
  source        String
  rawPayload    Json              @map("raw_payload")
  createdAt     DateTime          @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_events")
}

model Webhook {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([clientId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String                @map("webhook_id")
  transactionId  String                @map("transaction_id")
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  webhook     Webhook     @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model Provider {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  status         ProviderState @default(UNKNOWN)
  lastCheckedAt  DateTime?     @map("last_checked_at")
  lastSuccessAt  DateTime?     @map("last_success_at")
  lastResponseMs Int?          @map("last_response_ms")
  errorRate      Float         @default(0) @map("error_rate")
  message        String?
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("providers")
}

model ProviderLog {
  id           String   @id @default(uuid())
  providerCode String   @map("provider_code")
  operation    String
  requestId    String?  @map("request_id")
  success      Boolean
  responseMs   Int      @map("response_ms")
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([providerCode, createdAt])
  @@map("provider_logs")
}

model ApiLog {
  id          String          @id @default(uuid())
  requestId   String          @map("request_id")
  clientId    String?         @map("client_id")
  apiKeyId    String?         @map("api_key_id")
  endpoint    String
  method      String
  statusCode  Int             @map("status_code")
  responseMs  Int             @map("response_ms")
  ip          String?
  provider    String?
  environment ApiEnvironment?
  createdAt   DateTime        @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("api_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  clientId    String?  @map("client_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  ip          String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Invoice {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  subscriptionId String?       @map("subscription_id")
  amountCents    Int           @map("amount_cents")
  currency       String        @default("USD")
  status         InvoiceStatus @default(OPEN)
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("invoices")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model RateLimitCounter {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counters")
}

// A client adding money to their HaitiPay balance (a "recharge"), the same ways the
// payment provider offers its own partners: MonCash is automatic (hosted page,
// confirmed by the provider); the others are requests an administrator verifies.
enum FundingMethod {
  MONCASH
  NATCASH
  ZELLE
  BANK_DEPOSIT
  BANK_TRANSFER
  CRYPTO_USDT
  // Simulated credit for TEST (sandbox) balances; never real money.
  SANDBOX
}

enum FundingStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

model Funding {
  id                    String        @id
  clientId              String        @map("client_id")
  method                FundingMethod
  environment           ApiEnvironment @default(LIVE)
  amount                Decimal       @db.Decimal(14, 2)
  // What was actually credited (an administrator may adjust it when approving).
  creditedAmount        Decimal?      @db.Decimal(14, 2) @map("credited_amount")
  currency              Currency      @default(HTG)
  status                FundingStatus @default(PENDING)
  // Client-supplied proof (transfer id, hash...) for manual methods.
  reference             String?
  note                  String?
  providerTransactionId String?       @map("provider_transaction_id")
  paymentUrl            String?       @map("payment_url")
  reviewedBy            String?       @map("reviewed_by")
  reviewedAt            DateTime?     @map("reviewed_at")
  reviewNote            String?       @map("review_note")
  requestId             String        @map("request_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([providerTransactionId])
  @@index([status])
  @@map("fundings")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum KycAccountType {
  INDIVIDUAL
  BUSINESS
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  PROOF_OF_ADDRESS
  BUSINESS_REGISTRATION
}

// What the client declares about themselves and their business/website.
model KycProfile {
  clientId            String         @id @map("client_id")
  accountType         KycAccountType @map("account_type")
  fullName            String         @map("full_name")
  dateOfBirth         DateTime       @db.Date @map("date_of_birth")
  phone               String
  address             String
  city                String
  country             String         @default("HT")
  idType              String         @map("id_type")
  // The ID number is encrypted at rest; only the last 4 characters are kept in the clear.
  idNumberSealed      Json           @map("id_number_sealed")
  idNumberLast4       String         @map("id_number_last4")
  websiteUrl          String         @map("website_url")
  // HTTP status the site answered with when it was submitted (null = unreachable).
  websiteStatus       Int?           @map("website_status")
  websiteCheckedAt    DateTime?      @map("website_checked_at")
  businessName        String?        @map("business_name")
  businessDescription String         @map("business_description")
  expectedVolume      String?        @map("expected_volume")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

// Photos of the documents. The image bytes are encrypted (AES-256-GCM) before they are stored.
model KycDocument {
  id        String          @id @default(uuid())
  clientId  String          @map("client_id")
  type      KycDocumentType
  mime      String
  size      Int
  sha256    String
  data      Bytes
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type])
  @@map("kyc_documents")
}
