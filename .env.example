# ---- apps/api (backend — the ONLY place provider secrets ever live) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/haitipay?schema=public
# Direct (non-pooled) URL, used to run migrations on Vercel/Neon.
DATABASE_URL_UNPOOLED=

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORTAL_APP_URL=http://localhost:3000
CRON_SECRET=
TRIAL_DAYS=14

# Bazik (payment integrator). Owned by the platform operator: never sent to the
# frontend, never stored in the database, never logged. LIVE payments fail
# closed until the Bazik integration is implemented from its official docs.
BAZIK_API_URL=
BAZIK_API_KEY=
BAZIK_SECRET_KEY=
BAZIK_WEBHOOK_SECRET=

WEBHOOK_MAX_ATTEMPTS=6
RATE_LIMIT_TEST_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=600

# ---- apps/portal ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPPORT_EMAIL=
