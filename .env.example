# ---- apps/api/.env ----
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://ayitipay:ayitipay@localhost:5432/ayitipay?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 32-byte key (base64 or hex) used to AES-256-GCM encrypt developer-supplied
# MonCash/NatCash credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

PORTAL_APP_URL=http://localhost:3000

PLATFORM_DEFAULT_FEE_BPS=150

WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_WORKER_POLL_MS=10000

RATE_LIMIT_TEST_PER_MIN=60
RATE_LIMIT_LIVE_PER_MIN=120

# ---- apps/portal/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
