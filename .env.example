# ---- apps/api (backend — the ONLY place provider secrets ever live) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/haitipay?schema=public
# Direct (non-pooled) URL, used to run migrations on Vercel/Neon.
DATABASE_URL_UNPOOLED=

# Signs sessions. REQUIRED in production, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts what is stored in the database that must stay secret: the payment provider credentials
# entered in the admin panel and the identity-verification (KYC) documents. 32 random bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: without it that data cannot be read again. Do not change it once in use.
CREDENTIALS_ENCRYPTION_KEY=

# The portal's public address. Several may be listed, comma-separated (all are trusted origins;
# the first is used in links) — handy while moving to a new domain.
PORTAL_APP_URL=http://localhost:3000
# Protects the daily maintenance job (Vercel sends it as a bearer token).
CRON_SECRET=
# Public https URL of this API. LIVE transactions ask the provider to notify
# ${API_PUBLIC_URL}/webhooks/provider (falls back to VERCEL_PROJECT_PRODUCTION_URL).
API_PUBLIC_URL=

# Payment provider (integrator). Owned by the platform operator: never sent to the frontend,
# never returned by any endpoint, never logged. Normally an administrator enters these in the
# admin panel (Providers) — separately for receiving payments and for sending money — where they
# are stored encrypted. These variables are only a fallback for the "receive payments" account.
# PROVIDER_NAME is the label administrators see.
PROVIDER_NAME=
PROVIDER_API_URL=
PROVIDER_API_KEY=
PROVIDER_SECRET_KEY=
PROVIDER_WEBHOOK_SECRET=

WEBHOOK_MAX_ATTEMPTS=6
# Only used on a long-running host (not on Vercel): how often due webhook deliveries are retried.
WEBHOOK_WORKER_POLL_MS=10000
RATE_LIMIT_TEST_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=600

# ---- apps/portal ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the portal's /backend proxy sends requests (defaults to NEXT_PUBLIC_API_URL). Read at build time.
API_ORIGIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
