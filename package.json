{
  "name": "ayitipay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/portal",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:portal": "npm run dev --workspace apps/portal",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/portal",
    "test": "npm test --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "prisma:studio": "npm run prisma:studio --workspace apps/api"
  }
}
